# Copiá este archivo como `.env` (queda ignorado por git) y ajustá los valores.

# URL base de la API del backend. Debe terminar en "/api/".
#   Emulador Android -> backend en tu PC:  http://10.0.2.2:3000/api/
#   Dispositivo físico en tu red local:    http://<IP-de-tu-PC>:3000/api/  (agregá la IP a network_security_config.xml)
#   Backend desplegado:                    https://<tu-backend>/api/
API_BASE_URL=http://10.0.2.2:3000/api/
